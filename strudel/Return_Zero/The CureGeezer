
setcpm(60/4)

var climb = "<0 3 5 7>"
climb = "0"
const pat = n(irand(12).seg(8).rib("<316!2 314 316 314 316>", 1).add(climb)).scale("g:minor");

const mul = 2; //stop cyber go 2 go 4

saw_guitar: 
// s("gm_overdriven_guitar:[1,2,2,5,7], saw")
s("saw")
.chord("<Gm!2 Cm!2>").voicing()
  .transpose("-14")
  .room(2).delay(.5)  
  .lpf(saw.range(2200, 3000)) //remove effect drama
  .late(rand.range(0,.0075))
  // .jux(rev) //onoff
  .velocity(rand.range(.7,1))
  .att(0)
  .ply("<[16!3 -] [16!3 32]>".almostNever(x=>x.late(rand.range(0, .0005)))) //ply to strum

chime: s("marktrees").n("<-!3 <0 1 4 0>>")
kick: s("bd:2 - bd -".fast(mul)).bank("dr550").room(.2).vel(rand.range(.3, .4))
hat: s("-!7 oh").bank("dr550").room(.3).delay(.1).vel(rand.range(.13, .35))
snaretom: s("<- ht mt> <sd [lt sd - <- mt ht>]>".fast(mul)).bank("dr550").room(.3).delay(.1)

ride: s("rd!16").bank("dr550").room(.3)
  .delay(.1).vel(rand.range(.13, .35))
  .almostNever(x=>x.late(rand.range(0, .0005)))

subbass: n("0!4 - - 0 - 0!8".transpose(-7))
  .ply(2)
  .s("pulse, sine, saw").scale("<g:minor!2 c:minor!2>").unison(12)
  .distort("1:.3").att(.0001).rel(.3).lpf(500).lpenv(.2)
  .room(1).size(10)
  ._scope()









